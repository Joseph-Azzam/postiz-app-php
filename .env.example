# =============================================================================
# Postiz – Environment template
# =============================================================================
# Copy this file to .env and fill in values.
# Override per environment: .env.local (when APP_ENV=local) or .env.production
#   (when APP_ENV=production). Only .env, .env.example, .env.local, .env.production
#   are used; no .env.local.example or .env.production.example.
# Reference: http://docs.postiz.com/configuration/reference
# =============================================================================

# -----------------------------------------------------------------------------
# Environment selector
# -----------------------------------------------------------------------------
# local = load .env.local over .env | production = load .env.production over .env
APP_ENV=local

# -----------------------------------------------------------------------------
# App URLs (required)
# -----------------------------------------------------------------------------
# Must match the URL you use to open the app in the browser
FRONTEND_URL="http://localhost:4200"

# -----------------------------------------------------------------------------
# Backend: NestJS vs Laravel
# -----------------------------------------------------------------------------
# Set to laravel to use Laravel API; omit or nestjs for NestJS backend
# NEXT_PUBLIC_BACKEND_TYPE=laravel

# NestJS backend (default)
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

# Laravel backend (when NEXT_PUBLIC_BACKEND_TYPE=laravel)
# NEXT_PUBLIC_LARAVEL_BACKEND_URL="http://localhost/your-path/backend/public/api"
# BACKEND_INTERNAL_LARAVEL_URL="http://localhost/your-path/backend/public/api"

# -----------------------------------------------------------------------------
# Database – Postiz/NestJS (required when using NestJS)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/postiz-db"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-long-random-jwt-secret-string"

# -----------------------------------------------------------------------------
# Laravel app (backend-laravel)
# -----------------------------------------------------------------------------
# Override APP_KEY, APP_URL, DB_* in .env.local / .env.production as needed
APP_NAME=Postiz
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Laravel DB (override in .env.local / .env.production for MySQL)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Storage (avatars, uploads)
# -----------------------------------------------------------------------------
# local = store on disk; otherwise Cloudflare R2 is used (set vars below)
STORAGE_PROVIDER="local"
# UPLOAD_DIRECTORY="/path/to/uploads"
# NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/path/to/static"

# Cloudflare R2 (required if STORAGE_PROVIDER is not local)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ACCESS_KEY=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""
# CLOUDFLARE_BUCKETNAME=""
# CLOUDFLARE_BUCKET_URL="https://xxx.r2.cloudflarestorage.com/"
# CLOUDFLARE_REGION="auto"

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Resend (optional): if set, user activation is required; if commented out, users are active by default
# RESEND_API_KEY="re_xxxx"
# EMAIL_FROM_ADDRESS=""
# EMAIL_FROM_NAME=""
# DISABLE_REGISTRATION=false

# Laravel mail (production: set in .env.production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
# MAIL_FROM_NAME="${APP_NAME}"

# Require email verification to log in (Laravel). false = no activation email
# REQUIRE_EMAIL_VERIFICATION=false
# ACTIVATION_TOKEN_HOURS=24

# -----------------------------------------------------------------------------
# Social / integrations (optional – add as needed)
# -----------------------------------------------------------------------------
# X (Twitter): OAuth 2.0 – use Client ID / Secret as X_API_KEY / X_API_SECRET, or set X_CLIENT_ID / X_CLIENT_SECRET
# X_API_KEY=""
# X_API_SECRET=""
# LinkedIn: redirect = FRONTEND_URL/integrations/social/linkedin
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# BEEHIIVE_API_KEY=""
# BEEHIIVE_PUBLICATION_ID=""
# LISTMONK_DOMAIN=""
# LISTMONK_USER=""
# LISTMONK_API_KEY=""
# LISTMONK_LIST_ID=""
# THREADS_APP_ID=""
# THREADS_APP_SECRET=""
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
# TIKTOK_CLIENT_ID=""
# TIKTOK_CLIENT_SECRET=""
# PINTEREST_CLIENT_ID=""
# PINTEREST_CLIENT_SECRET=""
# DRIBBBLE_CLIENT_ID=""
# DRIBBBLE_CLIENT_SECRET=""
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
# DISCORD_BOT_TOKEN_ID=""
# SLACK_ID=""
# SLACK_SECRET=""
# SLACK_SIGNING_SECRET=""
# MASTODON_URL="https://mastodon.social"
# MASTODON_CLIENT_ID=""
# MASTODON_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI / Copilot (self-hosted Laravel runtime)
# -----------------------------------------------------------------------------
# Provider = gemini or openai; set the key for the provider you use
# COPILOT_PROVIDER=gemini
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# Models (self-hosted)
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# POSTIZ_AI_MODEL=gemini-2.5-flash
# POSTIZ_WRITER_MODEL=gemini-2.5-flash
# POSTIZ_IMAGE_MODEL=imagen-4.0-generate-001
# Rate limit: POSTIZ_GEMINI_RETRY_MAX=3, POSTIZ_GEMINI_RETRY_DELAY=65
# Optional: POSTIZ_TEST_KEY=xxx to protect /test dashboard with ?key=xxx

# -----------------------------------------------------------------------------
# Payments (Stripe)
# -----------------------------------------------------------------------------
# FEE_AMOUNT=0.05
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_SIGNING_KEY=""
# STRIPE_SIGNING_KEY_CONNECT=""

# -----------------------------------------------------------------------------
# Generic OAuth (e.g. Authentik)
# -----------------------------------------------------------------------------
# POSTIZ_GENERIC_OAUTH="false"
# POSTIZ_OAUTH_URL="https://auth.example.com"
# POSTIZ_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
# POSTIZ_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
# POSTIZ_OAUTH_USERINFO_URL="https://auth.example.com/application/o/userinfo"
# POSTIZ_OAUTH_CLIENT_ID=""
# POSTIZ_OAUTH_CLIENT_SECRET=""
# POSTIZ_OAUTH_SCOPE="openid profile email"
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME="Authentik"
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL="https://..."

# -----------------------------------------------------------------------------
# Short link services (optional)
# -----------------------------------------------------------------------------
# DUB_TOKEN=""
# DUB_API_ENDPOINT="https://api.dub.co"
# DUB_SHORT_LINK_DOMAIN="dub.sh"
# SHORT_IO_SECRET_KEY=""
# KUTT_API_KEY=""
# KUTT_API_ENDPOINT="https://kutt.it/api/v2"
# KUTT_SHORT_LINK_DOMAIN="kutt.it"
# LINK_DRIP_API_KEY=""
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/"
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink"

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# API_LIMIT=30
# NEXT_PUBLIC_DISCORD_SUPPORT=""
# NEXT_PUBLIC_POLOTNO=""
# NX_ADD_PLUGINS=false
# IS_GENERAL="true"
# NOT_SECURED=false

# Laravel cron / logging
# POSTIZ_DEBUG=false
# POSTIZ_CRON_BATCH_SIZE=10
# DEBUG_LOG=true
# LOG_LEVEL=debug

# Local only: disable SSL verification for outbound HTTPS (e.g. cURL 60 on WAMP)
# SSL_VERIFY=false
